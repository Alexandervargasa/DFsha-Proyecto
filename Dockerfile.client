FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY dfsha_pb2.py dfsha_pb2_grpc.py client.py ./

# Directorio para dejar/recoger archivos locales que se suben/descargan
# (montar un volumen aquí para poder pasar archivos desde el host)
WORKDIR /work

ENTRYPOINT ["python", "/app/client.py"]
CMD ["--host", "server", "--port", "50051"]
